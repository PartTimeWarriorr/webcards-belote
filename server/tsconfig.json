{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "target": "es2020",
        "module": "esnext", // Node runtime
        "outDir": "dist", // Compiled JS
        "esModuleInterop": true, // Node import compatibility
        "moduleResolution": "Node",
        "types": ["node", "jest"],
        "baseUrl": ".", // For path aliases
        "paths": {
            "@shared/*": ["../shared/*"] // Shared types
        },
        "sourceMap": true,
        "ignoreDeprecations": "6.0", // !!
        "rootDir": ".."
    },
    "include": ["src", "../shared/events.ts"]
}
